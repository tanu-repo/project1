# Playwright E2E Test Configuration
# Copy this file to `.env` and fill in the actual values

# Base URL for the application
BASE_URL=https://staging.ezra.com

# Staging test credentials
E2E_STAGING_TESTING_EMAIL=test-user@example.com
E2E_STAGING_TESTING_PASSWORD=your_password_here

# Stripe test credentials (if needed)
STRIPE_TEST_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Test environment (dev, stage, prod)
TEST_ENV=stage

# Login path (adjust based on your app)
LOGIN_PATH_STAGING=/login
